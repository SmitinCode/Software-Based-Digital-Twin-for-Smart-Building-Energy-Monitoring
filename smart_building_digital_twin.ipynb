import ipywidgets as widgets
from IPython.display import display, clear_output
import plotly.graph_objects as go

# -----------------------------
# Digital Twin Parameters
# -----------------------------
AC_POWER = 1.5
LIGHT_POWER = 0.1
FAN_POWER = 0.075

rooms = ["Room 1", "Room 2", "Room 3"]

# -----------------------------
# Controls
# -----------------------------
room_selector = widgets.Dropdown(
    options=rooms,
    description="Room:"
)

occupancy = widgets.IntSlider(
    value=5,
    min=0,
    max=20,
    description="People:"
)

ac = widgets.Checkbox(
    value=True,
    description="AC ON"
)

light = widgets.Checkbox(
    value=True,
    description="Light ON"
)

fan = widgets.Checkbox(
    value=True,
    description="Fan ON"
)

button = widgets.Button(
    description="Update Digital Twin",
    button_style="primary"
)

output = widgets.Output()

# -----------------------------
# Update Digital Twin
# -----------------------------
def update_twin(b=None):

    with output:
        clear_output(wait=True)

        energy = 0

        if ac.value:
            energy += AC_POWER

        if light.value:
            energy += LIGHT_POWER

        if fan.value:
            energy += FAN_POWER

        print("🏢 SMART BUILDING DIGITAL TWIN")
        print("--------------------------------")
        print("Room:", room_selector.value)
        print("Occupants:", occupancy.value)
        print("AC:", "ON" if ac.value else "OFF")
        print("Light:", "ON" if light.value else "OFF")
        print("Fan:", "ON" if fan.value else "OFF")
        print("--------------------------------")
        print(f"⚡ Energy Consumption: {energy:.3f} kW")

        if energy >= 1.6:
            print("🚨 ALERT: High Energy Consumption")
        else:
            print("✅ Energy Consumption Normal")

        # Graph
        devices = ["AC", "Light", "Fan"]

        values = [
            AC_POWER if ac.value else 0,
            LIGHT_POWER if light.value else 0,
            FAN_POWER if fan.value else 0
        ]

        fig = go.Figure(
            go.Bar(
                x=devices,
                y=values,
                text=values,
                textposition="auto"
            )
        )

        fig.update_layout(
            title=f"Digital Twin - {room_selector.value}",
            xaxis_title="Device",
            yaxis_title="Power (kW)"
        )

        fig.show()


button.on_click(update_twin)

display(
    room_selector,
    occupancy,
    ac,
    light,
    fan,
    button,
    output
)

update_twin()
